# Supabase Configuration
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Maps API Key (Opsional - Jika kosong, sistem otomatis menggunakan Google Maps URL embed fallback)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Admin Authentication & Session
JWT_SECRET=leadkit_bakery_super_secret_session_key_change_in_production
ADMIN_DEFAULT_PASSWORD=admin123456

# Mode Penyimpanan (local | supabase)
# Jika Supabase URL & Anon Key diisi, sistem otomatis menggunakan Supabase.
# Jika dibiarkan kosong, sistem otomatis menggunakan Local SQLite Engine (zero-config untuk development).
DATA_STORAGE_MODE=local
